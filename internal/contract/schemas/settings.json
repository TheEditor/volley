{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://volley.invalid/schema/1/settings",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "planner": {
      "type": "string",
      "default": "claude",
      "enum": [
        "claude",
        "codex"
      ],
      "x-volley-type": "string",
      "x-volley-validation": {
        "enum": [
          "claude",
          "codex"
        ]
      }
    },
    "backend": {
      "type": "string",
      "default": "cli",
      "enum": [
        "cli",
        "gashki"
      ],
      "x-volley-type": "string",
      "x-volley-validation": {
        "enum": [
          "cli",
          "gashki"
        ]
      }
    },
    "max_rounds": {
      "type": "integer",
      "default": 8,
      "minimum": 1,
      "maximum": 9999,
      "x-volley-type": "integer",
      "x-volley-validation": {
        "minimum": 1,
        "maximum": 9999
      }
    },
    "wait_timeout": {
      "type": "string",
      "default": "0s",
      "x-volley-type": "duration",
      "x-volley-validation": {
        "minimum": "0s"
      }
    },
    "poll_interval": {
      "type": "string",
      "default": "2s",
      "x-volley-type": "duration",
      "x-volley-validation": {
        "minimum": "10ms",
        "maximum": "1m"
      }
    },
    "persistent": {
      "type": "boolean",
      "default": false,
      "x-volley-type": "boolean",
      "x-volley-validation": {}
    },
    "closing_pass": {
      "type": "boolean",
      "default": true,
      "x-volley-type": "boolean",
      "x-volley-validation": {}
    },
    "second_opinion": {
      "type": "boolean",
      "default": false,
      "x-volley-type": "boolean",
      "x-volley-validation": {}
    },
    "rubric": {
      "type": "string",
      "default": "",
      "enum": [
        "",
        "security",
        "data",
        "decision-memo",
        "plan-spec"
      ],
      "x-volley-type": "string",
      "x-volley-validation": {
        "enum": [
          "",
          "security",
          "data",
          "decision-memo",
          "plan-spec"
        ]
      }
    },
    "context_dir": {
      "type": "string",
      "default": "",
      "x-volley-type": "path",
      "x-volley-validation": {
        "outside_workspace": true
      },
      "x-volley-source-base": "Relative file values use the file directory. Relative flag values use the invocation cwd. Bare executable names use PATH."
    },
    "claude_bin": {
      "type": "string",
      "default": "claude",
      "x-volley-type": "executable",
      "x-volley-validation": {},
      "x-volley-source-base": "Relative file values use the file directory. Relative flag values use the invocation cwd. Bare executable names use PATH.",
      "x-volley-inactive-when": {
        "backend": "gashki"
      }
    },
    "codex_bin": {
      "type": "string",
      "default": "codex",
      "x-volley-type": "executable",
      "x-volley-validation": {},
      "x-volley-source-base": "Relative file values use the file directory. Relative flag values use the invocation cwd. Bare executable names use PATH.",
      "x-volley-inactive-when": {
        "backend": "gashki"
      }
    },
    "gashki_bin": {
      "type": "string",
      "default": "gashki",
      "x-volley-type": "executable",
      "x-volley-validation": {},
      "x-volley-source-base": "Relative file values use the file directory. Relative flag values use the invocation cwd. Bare executable names use PATH.",
      "x-volley-inactive-when": {
        "backend": "cli"
      }
    },
    "gashki_config": {
      "type": "string",
      "default": "",
      "x-volley-type": "path",
      "x-volley-validation": {},
      "x-volley-source-base": "Relative file values use the file directory. Relative flag values use the invocation cwd. Bare executable names use PATH."
    },
    "claude_model": {
      "type": "string",
      "default": "",
      "x-volley-type": "string",
      "x-volley-validation": {
        "identifier": true
      }
    },
    "codex_model": {
      "type": "string",
      "default": "",
      "x-volley-type": "string",
      "x-volley-validation": {
        "identifier": true
      }
    },
    "claude_effort": {
      "type": "string",
      "default": "",
      "enum": [
        "",
        "low",
        "medium",
        "high",
        "xhigh",
        "max"
      ],
      "x-volley-type": "string",
      "x-volley-validation": {
        "enum": [
          "",
          "low",
          "medium",
          "high",
          "xhigh",
          "max"
        ]
      }
    },
    "codex_effort": {
      "type": "string",
      "default": "",
      "x-volley-type": "string",
      "x-volley-validation": {
        "identifier": true
      }
    },
    "claude_permission_mode": {
      "type": "string",
      "default": "dontAsk",
      "enum": [
        "dontAsk"
      ],
      "x-volley-type": "string",
      "x-volley-validation": {
        "enum": [
          "dontAsk"
        ]
      }
    },
    "claude_planner_tools": {
      "type": "array",
      "default": [
        "Read",
        "Write",
        "Edit",
        "Glob",
        "Grep",
        "Skill"
      ],
      "items": {
        "enum": [
          "Read",
          "Write",
          "Edit",
          "Glob",
          "Grep",
          "Skill"
        ]
      },
      "uniqueItems": true,
      "x-volley-type": "array",
      "x-volley-validation": {
        "items": [
          "Read",
          "Write",
          "Edit",
          "Glob",
          "Grep",
          "Skill"
        ]
      }
    },
    "claude_critic_tools": {
      "type": "array",
      "default": [
        "Read",
        "Glob",
        "Grep",
        "Skill"
      ],
      "items": {
        "enum": [
          "Read",
          "Glob",
          "Grep",
          "Skill"
        ]
      },
      "uniqueItems": true,
      "x-volley-type": "array",
      "x-volley-validation": {
        "items": [
          "Read",
          "Glob",
          "Grep",
          "Skill"
        ]
      }
    },
    "trust_folder": {
      "type": "boolean",
      "default": false,
      "x-volley-type": "boolean",
      "x-volley-validation": {}
    },
    "placement": {
      "type": "string",
      "default": "auto",
      "enum": [
        "auto",
        "normal",
        "here"
      ],
      "x-volley-type": "string",
      "x-volley-validation": {
        "enum": [
          "auto",
          "normal",
          "here"
        ]
      }
    },
    "allow_api_key": {
      "type": "boolean",
      "default": false,
      "x-volley-type": "boolean",
      "x-volley-validation": {}
    }
  },
  "required": [
    "planner",
    "backend",
    "max_rounds",
    "wait_timeout",
    "poll_interval",
    "persistent",
    "closing_pass",
    "second_opinion",
    "rubric",
    "context_dir",
    "claude_bin",
    "codex_bin",
    "gashki_bin",
    "gashki_config",
    "claude_model",
    "codex_model",
    "claude_effort",
    "codex_effort",
    "claude_permission_mode",
    "claude_planner_tools",
    "claude_critic_tools",
    "trust_folder",
    "placement",
    "allow_api_key"
  ],
  "description": "Flat Volley settings. Effective precedence is flag, file, then declared default. No setting environment variables or profiles."
}
