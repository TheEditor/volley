{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://volley.invalid/schema/1/data-doctor",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "ok": {
            "type": "boolean"
          },
          "detail": {
            "type": "string"
          },
          "recommended_action": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "command": {
                "type": "string"
              },
              "rationale": {
                "type": "string"
              },
              "is_destructive": {
                "type": "boolean"
              },
              "alternatives": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "command": {
                      "type": "string"
                    },
                    "purpose": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "command",
                    "purpose"
                  ]
                }
              }
            },
            "required": [
              "command",
              "rationale",
              "is_destructive",
              "alternatives"
            ]
          }
        },
        "required": [
          "name",
          "ok",
          "detail",
          "recommended_action"
        ]
      }
    },
    "recommended_action": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "command": {
          "type": "string"
        },
        "rationale": {
          "type": "string"
        },
        "is_destructive": {
          "type": "boolean"
        },
        "alternatives": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "command": {
                "type": "string"
              },
              "purpose": {
                "type": "string"
              }
            },
            "required": [
              "command",
              "purpose"
            ]
          }
        }
      },
      "required": [
        "command",
        "rationale",
        "is_destructive",
        "alternatives"
      ]
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "planner": {
          "type": "string"
        },
        "backend": {
          "type": "string"
        },
        "max_rounds": {
          "type": "integer"
        },
        "wait_timeout": {
          "type": "string"
        },
        "poll_interval": {
          "type": "string"
        },
        "persistent": {
          "type": "boolean"
        },
        "closing_pass": {
          "type": "boolean"
        },
        "second_opinion": {
          "type": "boolean"
        },
        "rubric": {
          "type": "string"
        },
        "context_dir": {
          "type": "string"
        },
        "claude_bin": {
          "type": "string"
        },
        "codex_bin": {
          "type": "string"
        },
        "gashki_bin": {
          "type": "string"
        },
        "gashki_config": {
          "type": "string"
        },
        "claude_model": {
          "type": "string"
        },
        "codex_model": {
          "type": "string"
        },
        "claude_effort": {
          "type": "string"
        },
        "codex_effort": {
          "type": "string"
        },
        "claude_permission_mode": {
          "type": "string"
        },
        "claude_planner_tools": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "claude_critic_tools": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "trust_folder": {
          "type": "boolean"
        },
        "placement": {
          "type": "string"
        },
        "allow_api_key": {
          "type": "boolean"
        }
      },
      "required": [
        "planner",
        "backend",
        "max_rounds",
        "wait_timeout",
        "poll_interval",
        "persistent",
        "closing_pass",
        "second_opinion",
        "rubric",
        "context_dir",
        "claude_bin",
        "codex_bin",
        "gashki_bin",
        "gashki_config",
        "claude_model",
        "codex_model",
        "claude_effort",
        "codex_effort",
        "claude_permission_mode",
        "claude_planner_tools",
        "claude_critic_tools",
        "trust_folder",
        "placement",
        "allow_api_key"
      ]
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "checks",
    "recommended_action",
    "settings",
    "warnings"
  ]
}
