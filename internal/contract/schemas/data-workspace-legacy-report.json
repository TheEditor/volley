{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://volley.invalid/schema/1/data-workspace-legacy-report",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "workspace": {
      "type": "string"
    },
    "classification": {
      "type": "string"
    },
    "markers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string"
          },
          "bytes": {
            "type": "integer"
          },
          "type": {
            "type": "string"
          },
          "device": {
            "type": "integer"
          },
          "inode": {
            "type": "integer"
          }
        },
        "required": [
          "path",
          "sha256",
          "bytes",
          "type",
          "device",
          "inode"
        ]
      }
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "value": {
            "type": "string"
          },
          "sha256": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "value",
          "sha256"
        ]
      }
    },
    "unknown": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "active_execution": {
      "type": "string"
    },
    "recipe": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "workspace",
    "classification",
    "markers",
    "facts",
    "unknown",
    "active_execution",
    "recipe"
  ]
}
