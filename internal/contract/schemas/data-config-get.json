{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://volley.invalid/schema/1/data-config-get",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "key": {
      "type": "string"
    },
    "value": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "integer"
        },
        {
          "type": "boolean"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "line": {
          "type": "integer"
        },
        "flag": {
          "type": "string"
        },
        "argument_position": {
          "type": "integer"
        },
        "rule": {
          "type": "string"
        }
      },
      "required": [
        "source",
        "path",
        "line",
        "flag",
        "argument_position",
        "rule"
      ]
    }
  },
  "required": [
    "key",
    "value",
    "source"
  ]
}
