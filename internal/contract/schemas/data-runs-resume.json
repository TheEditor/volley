{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://volley.invalid/schema/1/data-runs-resume",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "run_id": {
      "type": "string"
    },
    "workspace": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "phase": {
      "type": "string"
    },
    "round": {
      "type": "integer"
    },
    "max_rounds": {
      "type": "integer"
    },
    "turn": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string"
            },
            "purpose": {
              "type": "string"
            },
            "role": {
              "type": "string"
            },
            "round": {
              "type": "integer"
            },
            "attempt": {
              "type": "integer"
            },
            "intent_hash": {
              "type": "string"
            },
            "prompt_path": {
              "type": "string"
            },
            "prompt_hash": {
              "type": "string"
            },
            "operation": {
              "type": "string"
            },
            "delivery_uncertain": {
              "type": "boolean"
            },
            "receipt_path": {
              "type": "string"
            },
            "cursor": {
              "type": "string"
            },
            "started_at": {
              "type": "string"
            },
            "budget": {
              "type": "string"
            },
            "remaining": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "purpose",
            "role",
            "round",
            "attempt",
            "intent_hash",
            "prompt_path",
            "prompt_hash",
            "operation",
            "delivery_uncertain",
            "receipt_path",
            "cursor",
            "started_at",
            "budget",
            "remaining"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "question_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "spec_hash": {
      "type": "string"
    },
    "owner": {
      "type": "string"
    },
    "retention": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "panes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "processes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "pid": {
                "type": "integer"
              },
              "pgid": {
                "type": "integer"
              },
              "start_identity": {
                "type": "string"
              },
              "verified": {
                "type": "boolean"
              }
            },
            "required": [
              "pid",
              "pgid",
              "start_identity",
              "verified"
            ]
          }
        }
      },
      "required": [
        "kind",
        "reason",
        "panes",
        "processes"
      ]
    },
    "next_action": {
      "type": "string"
    },
    "recommended_action": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "command": {
              "type": "string"
            },
            "rationale": {
              "type": "string"
            },
            "is_destructive": {
              "type": "boolean"
            },
            "alternatives": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "command": {
                    "type": "string"
                  },
                  "purpose": {
                    "type": "string"
                  }
                },
                "required": [
                  "command",
                  "purpose"
                ]
              }
            }
          },
          "required": [
            "command",
            "rationale",
            "is_destructive",
            "alternatives"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "pending_inputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "final_result": {
      "$ref": "final-result.json"
    }
  },
  "required": [
    "run_id",
    "workspace",
    "status"
  ]
}
